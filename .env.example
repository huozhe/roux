# Database (Neon). Tables live in schema `roux` (not public).
# After setting URL: npm run db:init-schema && npm run db:push
DATABASE_URL=

# Auth.js
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Public app URL, e.g. http://localhost:3000
AUTH_URL=http://localhost:3000

# Encrypt Google refresh tokens at rest (32-byte secret, base64 or hex)
TOKEN_ENCRYPTION_KEY=

# Claude extraction
ANTHROPIC_API_KEY=

# Vercel Cron (Authorization: Bearer $CRON_SECRET)
CRON_SECRET=

# --- Local sync (npm run sync) ---
# YouTube caption cookies when tracks return auth_blocked / LOGIN_REQUIRED.
# Netscape cookie file contents or browser cookie string; local-only, never set on Vercel.
# YOUTUBE_COOKIES=

# Cap new extracts per run (default 5). Example: SYNC_MAX_NEW=50
# SYNC_MAX_NEW=

# Force videos.list status check even when there is no extract work (default off).
# FORCE_STATUS_CHECK=1

# Email of the app user to sync as (defaults to sole user / first user).
# ROUX_SYNC_EMAIL=you@example.com

# Allow POST /api/sync on Vercel (default off — YouTube blocks datacenter captions).
# Only enable if you accept cookie/proxy tradeoffs.
# SYNC_ALLOW_CLOUD=true
